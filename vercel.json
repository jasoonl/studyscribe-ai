{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "framework": null,
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "drizzle/**/*"
    }
  },
  "crons": [
    { "path": "/api/cron/follow-up-reminders", "schedule": "0 13 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "/manus-storage/(.*)", "dest": "/api/index.mjs" },
    { "src": "/healthz", "dest": "/api/index.mjs" },
    { "src": "/.well-known/apple-app-site-association", "headers": { "Content-Type": "application/json", "Cache-Control": "public, max-age=3600" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
